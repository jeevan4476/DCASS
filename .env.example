# DCASS environment configuration (copy to .env)

# Device override for model inference ('cuda' or 'cpu')
#DCASS_DEVICE=cpu

# Comma-separated list of allowed CORS origins for the FastAPI backend
#DCASS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend API base URL (used by the Next.js app)
#NEXT_PUBLIC_API_URL=http://localhost:8000
