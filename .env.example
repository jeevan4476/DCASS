# DCASS environment configuration (copy to .env before deploying)

# Runtime environment ('development' or 'production')
# In production, set DCASS_JWT_SECRET and DCASS_API_TOKEN to strong random secrets.
#DCASS_ENV=production
#DCASS_JWT_SECRET=replace-with-32-plus-char-random-secret
#DCASS_API_TOKEN=replace-with-32-plus-char-api-token

# Device override for model inference ('cuda' or 'cpu')
#DCASS_DEVICE=cpu

# Comma-separated list of allowed CORS origins for the FastAPI backend
#DCASS_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Optional out-of-band context key secret for HMAC payload framing
#DCASS_CONTEXT_SECRET=

# Bounded concurrent /api/transmit sessions
#DCASS_MAX_CONCURRENT_TRANSMISSIONS=4

# Host ports and public URLs for Docker Compose / local stack
#API_PORT=8000
#FRONTEND_PORT=3001
#NEXT_PUBLIC_API_URL=http://localhost:8000

# Public domain for Caddy HTTPS reverse proxy (`docker compose --profile web --profile proxy up`)
#DOMAIN=dcass.example.com
